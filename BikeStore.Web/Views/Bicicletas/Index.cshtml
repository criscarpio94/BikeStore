@model IEnumerable<BikeStore.Web.Models.BicicletaViewModel>

@{
    ViewData["Title"] = "Gestión de Bicicletas";
}

<div class="container mt-4">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@(TempData["TipoMensaje"] ?? "info") alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🚲 Gestión de Bicicletas</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nueva Bicicleta</a>
    </div>

    <!-- Formulario de Filtros y busqueda -->
    <div class="card p-3 mb-4 bg-light shadow-sm">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <input type="text" name="marca" class="form-control" placeholder="Buscar por marca..." value="@Context.Request.Query["marca"]" />
            </div>
            <div class="col-md-3">
                <select name="idCategoria" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                    @foreach (var cat in (IEnumerable<BikeStore.Web.Models.CategoriaViewModel>)(ViewBag.Categorias ?? Enumerable.Empty<BikeStore.Web.Models.CategoriaViewModel>()))
                    {
                        if (ViewBag.IdCategoriaSeleccionada == cat.IdCategoria.ToString())
                        {
                            <option value="@cat.IdCategoria" selected="selected">@cat.Nombre</option>
                        }
                        else
                        {
                            <option value="@cat.IdCategoria">@cat.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="stockBajo" value="true" id="stockBajoCheck" @(Context.Request.Query["stockBajo"] == "true" ? "checked" : "")>
                    <label class="form-check-label fw-bold text-danger" for="stockBajoCheck">
                        ⚠️ Ver solo stock bajo (≤ 5)
                    </label>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-50">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-dark w-50">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Tabla de Registros -->
    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Modelo</th>
                <th>Marca</th>
                <th>Precio</th>
                <th>Stock</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr class="@(item.Stock <= 5 ? "table-warning" : "")">
                        <td class="fw-bold">@item.IdBicicleta</td>
                        <td>@item.Modelo</td>
                        <td>@item.Marca</td>
                        <td>$@item.Precio.ToString("F2")</td>
                        <td>
                            @item.Stock
                            @if (item.Stock <= 5)
                            {
                                <span class="badge bg-danger ms-1">Bajo</span>
                            }
                        </td>
                        <td class="text-center">
                            <!-- Editar -->
                            <a asp-action="Edit" asp-route-id="@item.IdBicicleta" class="btn btn-warning btn-sm me-1">Editar</a>

                            <!-- Eliminar -->
                            <form asp-action="Delete" asp-route-id="@item.IdBicicleta" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta bicicleta?');">
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No se encontraron bicicletas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>