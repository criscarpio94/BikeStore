@model IEnumerable<BikeStore.Web.Models.VentaViewModel>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🛒 Historial de Ventas</h2>
        <a asp-action="Create" class="btn btn-success">+ Nueva Venta</a>
    </div>

    <!-- Filtro por Cliente (Escenario #9) -->
    <div class="card p-3 mb-4 bg-light shadow-sm">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="number" name="clienteId" class="form-control" placeholder="Ingrese ID del Cliente..." value="@Context.Request.Query["clienteId"]" />
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-50">Buscar por Cliente</button>
                <a asp-action="Index" class="btn btn-outline-dark w-50">Ver Todas</a>
            </div>
        </form>
    </div>

    <!-- Tabla de Ventas -->
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th># Venta</th>                
                <th>ID Cliente</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Subtotal</th>
                <th>IVA</th>
                <th>Total</th>
                <th class="text-center">Acciones</th>
                
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var venta in Model)
                {
                    <tr>
                        <td>@venta.IdVenta</td>
                        <td>@venta.IdCliente</td>
                        <td class="fw-bold">@venta.NombreCliente</td>
                        <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@venta.Subtotal.ToString("F2")</td>
                        <td>@venta.Iva.ToString("F2")</td>
                        <td>@venta.Total.ToString("F2")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@venta.IdVenta" class="btn btn-info btn-sm">Ver Detalle</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay registros de ventas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>