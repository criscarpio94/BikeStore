@model IEnumerable<BikeStore.Web.Models.CategoriaViewModel>

<div class="container mt-4">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@(TempData["TipoMensaje"] ?? "info") alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h2>Gestión de Categorías</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Nueva Categoría</a>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCategoria</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>
                        <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">
                            @(item.Activo ? "Activa" : "Inactiva")
                        </span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-warning btn-sm me-1">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.IdCategoria" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que deseas eliminar esta categoría?');">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
