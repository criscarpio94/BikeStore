@model IEnumerable<BikeStore.Web.Models.ClienteViewModel>

<div class="container mt-4">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@(TempData["TipoMensaje"] ?? "info") alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h2>Gestión de Clientes</h2>

    <form asp-action="Index" method="get" class="row g-3 mb-4 mt-2 card p-3 shadow-sm">
        <div class="row align-items-center m-0">
            <div class="col-md-4">
                <input type="text" name="cedula" class="form-control" placeholder="Buscar por Cédula..."
                       value="@Context.Request.Query["cedula"]" />
            </div>
            <div class="col-md-4">
                <input type="text" name="apellido" class="form-control" placeholder="Buscar por Apellido..."
                       value="@Context.Request.Query["apellido"]" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-dark w-100">Buscar</button>
            </div>
        </div>
    </form>

    <a asp-action="Create" class="btn btn-primary mb-3">Registrar Cliente</a>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Cédula</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Cedula</td>
                    <td>@c.Nombres</td>
                    <td>@c.Apellidos</td>
                    <td>@c.Telefono</td>
                    <td>@c.Correo</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@c.IdCliente" class="btn btn-warning btn-sm me-1">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.IdCliente" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que deseas eliminar este cliente?');">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
