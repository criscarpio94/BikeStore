@model BikeStore.Web.Models.ClienteViewModel

<div class="container mt-4">
    <h2>Editar Cliente</h2>
    <form asp-action="Edit" method="post" class="card p-4 shadow-sm mt-3">
        <input type="hidden" asp-for="IdCliente" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Cédula</label>
            <input asp-for="Cedula" class="form-control" maxlength="10" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Nombres</label>
            <input asp-for="Nombres" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Apellidos</label>
            <input asp-for="Apellidos" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo Electrónico</label>
            <input asp-for="Correo" type="email" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
